# 주의: Cloudflare 는 여러 규칙이 같은 경로에 매치되면 헤더를 덮어쓰지 않고 콤마로 이어붙인다.
# 따라서 규칙끼리 겹치지 않게 경로를 나눠 적어야 한다 (`/*` 캐치올 금지).

# --- HTML ---
# 기본값 `public, max-age=0, must-revalidate` 를 그대로 두면 htmx preload 가 응답을
# 브라우저 캐시에 남기지 못해 선요청이 무의미해진다. 짧은 max-age 가 반드시 필요하다.
/
  Cache-Control: public, max-age=60, stale-while-revalidate=86400
/posts
  Cache-Control: public, max-age=60, stale-while-revalidate=86400
/posts/*
  Cache-Control: public, max-age=60, stale-while-revalidate=86400
/resume
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

# 확장자 기반 기본값은 application/xml 이라 RSS 타입을 명시한다.
# Cache-Control 은 위 /posts/* 규칙이 이미 담당하므로 여기서 다시 적지 않는다
# (같은 헤더를 두 규칙이 적으면 콤마로 이어붙는다).
/posts/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
/404
  Cache-Control: public, max-age=60, stale-while-revalidate=86400

# --- 해시가 붙거나 사실상 불변인 자산 ---
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable

# --- 내용이 바뀔 수 있는 정적 파일 ---
/og/*
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon-16.png
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
