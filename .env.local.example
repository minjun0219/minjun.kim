# 사이트 URL (sitemap, RSS, OpenGraph 메타에 쓰임)
HOMEPAGE=https://minjun.kim

# 네이버 사이트 소유 확인 (빌드타임에 <head> 로 들어감)
NAVER_SITE_VERIFICATION=...

# 브라우저 번들로 들어가는 값 (vite.client.config.ts 의 envPrefix 가 POSTHOG_ 를 연다)
# 이 키가 목적지 프로젝트를 정한다 — 아래 호스트는 경유지일 뿐이다.
POSTHOG_KEY=...
# PostHog 조직 공용 managed reverse proxy. 개인 프로젝트는 전부 이걸 쓴다.
# 키가 있는데 이 값이 비면 빌드가 실패한다(posthog-js 기본값으로 프록시를 우회하는 걸 막는 가드).
POSTHOG_HOST=https://z.minjun.kim
