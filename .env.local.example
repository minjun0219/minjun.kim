# 사이트 URL (sitemap, RSS, OpenGraph 메타에 쓰임)
HOMEPAGE=https://minjun.kim

# 네이버 사이트 소유 확인 (빌드타임에 <head> 로 들어감)
NAVER_SITE_VERIFICATION=...

# 브라우저 번들로 들어가는 값 (Vite 규칙상 VITE_ 접두사 필수)
VITE_POSTHOG_KEY=...
# US: https://us.i.posthog.com (기본), EU: https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
